VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_EXPORT_CENSUS_PASSWORD=change-this-export-password
VITE_REPORT_EXPORT_PASSWORD=change-this-report-export-password

# The deploy surface is NOT set here.
#
# The app ships as two deployments — the staff portal and the patient/enrollee
# portal — and the surface is selected by Vite mode, which reads `.env.<mode>`:
#
#   npm run dev:admin   -> .env.admin   -> staff portal      on :5173
#   npm run dev:user    -> .env.user    -> patient portal    on :5174
#
# Both can run at once, which is what you want when testing a flow that crosses
# the two, such as an enrollee signing up and a nurse reviewing the submission.
#
# Do not add VITE_DEPLOY_SURFACE to this file. It is loaded for every mode and
# would silently override both.
