# ============================================================================
# Dependencies
# ============================================================================
# Reinstalled by `npm install` on every build (see vercel.json installCommand),
# so committing them only bloats the repo and lets the installed tree drift
# away from package-lock.json.
node_modules/

# ============================================================================
# Build output
# ============================================================================
# Vercel builds from source and serves `dist` as outputDirectory (vercel.json),
# so the built files are generated, never edited by hand.
dist/
dist-ssr/
*.local

# ============================================================================
# Environment
# ============================================================================
# Real credentials. Committed once and still in the history — untracking stops
# future changes leaking, but the values should be rotated regardless.
# `.env.example` stays tracked: it is the template, with placeholders only.
.env
.env.local
.env.*.local

# ============================================================================
# Supabase CLI
# ============================================================================
# Local CLI state (project ref, versions, pooler URL) — machine-specific.
supabase/.temp/

# ============================================================================
# Scratch
# ============================================================================
# One-off probes and verification scripts used while investigating.
scratch/

# ============================================================================
# Nested repositories
# ============================================================================
# `reviewer/` is a separate git repository that was once recorded in this one as
# a gitlink (mode 160000) with no .gitmodules to resolve it. That makes
# `actions/checkout` fail with "No url found for submodule path 'reviewer'", so
# every workflow dies before it starts. A gitlink stores only a commit hash —
# none of its files were ever in this repository — so ignoring it loses nothing.
# The work itself lives in that repository's own history.
reviewer/

# ============================================================================
# Generated sample output
# ============================================================================
sample-output/

# ============================================================================
# Logs
# ============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================================
# Editor and OS
# ============================================================================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ============================================================================
# Test output
# ============================================================================
coverage/
.nyc_output/
